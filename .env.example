# ---------------------------------------------------------------------------
# Copy to .env (local) or set in your hosting provider's environment settings.
# ---------------------------------------------------------------------------

# --- Database (Supabase / any Postgres) ------------------------------------
# Use the Transaction Pooler URL (port 6543) for the app.
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Optional: max connections per server instance (default 5).
# DATABASE_POOL_MAX=5

# --- Site --------------------------------------------------------------------
# Public base URL, no trailing slash. Used for IntaSend redirects, SEO and the sitemap.
APP_URL=http://localhost:3000

# --- Delivery pricing (public: shown in the cart) ----------------------------
# Flat delivery fee in KES charged below the free-delivery threshold. 0 = always free.
NEXT_PUBLIC_DELIVERY_FEE_KES=0
NEXT_PUBLIC_FREE_DELIVERY_THRESHOLD_KES=5000

# --- IntaSend payments ---------------------------------------------------------
# Publishable key from the IntaSend dashboard (ISPubKey_test_... in sandbox, ISPubKey_live_... in production).
INTASEND_PUBLISHABLE_KEY=
# Secret key: not needed for checkout; keep it here for future refunds/payouts.
INTASEND_SECRET_KEY=
# "true" uses sandbox.intasend.com, "false" uses payment.intasend.com.
INTASEND_TEST_ENVIRONMENT=true
# The "Challenge" string you set on the webhook in IntaSend (Settings -> Webhooks).
# Webhook URL to register: ${APP_URL}/api/webhooks/intasend  (event: collection_event)
INTASEND_WEBHOOK_CHALLENGE=
# Optional override of the IntaSend API host (testing only).
# INTASEND_API_BASE_URL=

# --- Email (Resend) — optional; emails are skipped when unset -------------------
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Kiriti Tea <orders@yourdomain.co.ke>"
EMAIL_FROM=
# Where new-order alerts go (defaults to the company email in src/data/company-data.json).
ORDER_NOTIFICATION_EMAIL=

# --- Admin (/admin) -------------------------------------------------------------
# Admin is disabled until ADMIN_PASSWORD is set. Use a long, random password.
ADMIN_PASSWORD=
# Signs admin session cookies. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
